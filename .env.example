# OpenAI 兼容接口的 API Key。
OPENAI_API_KEY=your_api_key_here

# OpenAI 官方地址，或你使用的中转站地址。
OPENAI_BASE_URL=https://api.openai.com/v1

# 你的接口支持的聊天模型名称。
MODEL_NAME=gpt-4o-mini

# 模型温度，一般填写 0 到 1 之间的数字。
TEMPERATURE=0.7

# RAG 知识库使用的向量模型。
EMBEDDING_MODEL=text-embedding-3-small

# 用于签名登录 JWT 的随机字符串，建议填写一串较长的内容。
JWT_SECRET=replace_with_a_long_random_secret

# MCP 服务地址。没有启动 MCP 时，Agent 会自动回退到本地工具。
# 本地直接运行 Python 时使用 127.0.0.1；Docker Compose 会自动改为宿主机地址。
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

# WeKnora 地址和 API Key。V2 默认使用 WeKnora。
WEKNORA_BASE_URL=http://127.0.0.1:8080
WEKNORA_API_KEY=
WEKNORA_TIMEOUT_SECONDS=10
# 自动创建 WeKnora 知识库时使用的 Embedding 模型名称或 ID。
# 项目会从 WeKnora 模型列表中自动解析名称对应的真实 ID。
WEKNORA_EMBEDDING_MODEL_ID=

# V2 默认使用 WeKnora。只有明确做离线测试时才改成 local。
KNOWLEDGE_PROVIDER=weknora
# 已有 WeKnora 知识库可以直接填写 ID；留空则首次上传 Markdown 时自动创建。
WEKNORA_KNOWLEDGE_BASE_ID=

# Redis 负责共享登录限流和缓存状态。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TIMEOUT_SECONDS=1

# PostgreSQL 保存用户、Agent、订单、退款、会话和消息。
# 直接在本机运行 Python 时使用 127.0.0.1；Docker Compose 会自动改成 postgres 服务名。
POSTGRES_USER=ecom_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ecom_agent
POSTGRES_DSN=postgresql://ecom_agent:change-me@127.0.0.1:5432/ecom_agent

# SQLite 仅作为离线学习备用模式。
DATABASE_PATH=data/app.db
DATABASE_BACKEND=postgres

# 允许访问后端的前端地址，多个地址用英文逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8088,http://127.0.0.1:8088

# Docker Compose 构建前端时使用的后端地址。浏览器访问时必须是宿主机可访问的地址。
FRONTEND_API_BASE_URL=http://localhost:8765

# Docker Compose 中 Agent 前端使用 8088，避开 WeKnora 的 80/8080 端口。
FRONTEND_PORT=8088

# Docker Compose 连接宿主机服务时使用的地址，通常不用修改。
WEKNORA_COMPOSE_BASE_URL=http://host.docker.internal:8080
MCP_COMPOSE_SERVER_URL=http://host.docker.internal:9123/mcp
